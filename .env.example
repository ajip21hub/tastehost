# Qloo (hackathon key only works against the hackathon base URL). Server-side only.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# LLM (optional). Pick ONE way:
#  a) set a well-known key: OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY / XAI_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY
#  b) or explicitly: LLM_PROVIDER=openai|anthropic|groq|xai|gemini|openrouter|custom + LLM_API_KEY (+ LLM_MODEL, LLM_BASE_URL)
# LLM_MODEL can be a comma list: first is primary, the rest are fallbacks on 404/429/5xx/timeout.
# With no LLM key the agent runs in deterministic mode (same Qloo tools, template explanations).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
